# Production: copy the TLS URL from Upstash's Connect panel.
# Do not put this value in frontend environment variables or commit a real token.
REDIS_URL=rediss://default:<UPSTASH_REDIS_PASSWORD>@<UPSTASH_ENDPOINT>:6379

# Optional cache-client tuning. Defaults are suitable for a few hundred users.
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT_SECONDS=0.75
